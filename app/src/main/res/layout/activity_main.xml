<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Header / Logo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RetroShare Web"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Native Android Core + Embedded RSNewWebUI"
        android:textColor="#A0A0AB"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="32dp" />

    <!-- Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E24"
        android:padding="20dp"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/statusIndicator"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@color/status_green"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Node Service: Connected"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtApiAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Local API: http://127.0.0.1:9092"
            android:textColor="#A0A0AB"
            android:textSize="13sp"
            android:layout_marginTop="10dp" />

    </LinearLayout>

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnOpenWebUI"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="OPEN RETROSHARE WEBUI"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="@color/accent_blue"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnToggleService"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Restart Background Node"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:backgroundTint="#2E2E38"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnOpenBrowser"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Open in External Browser"
        android:textColor="#A0A0AB"
        android:textSize="14sp"
        android:backgroundTint="#1E1E24" />

</LinearLayout>
